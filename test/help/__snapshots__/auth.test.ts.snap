// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`auth --help > auth 1`] = `
"Usage: pingcode auth [options] [command]

authenticate against PingCode (enterprise app or user token)

Options:
  -h, --help        display help for command

Commands:
  login [options]   acquire a token (user token by default) and verify it
  status [options]  show host, masked client id and token state
  logout [options]  clear the active token slot (both with --all) and the metadata cache
  help [command]    display help for command
"
`;

exports[`auth login --help > pins the mode/channel/code flag surface (design D10/D12) 1`] = `
"Usage: pingcode auth login [options]

acquire a token (user token by default) and verify it

Options:
  --client-id <id>          app client id (or PINGCODE_CLIENT_ID)
  --client-secret <secret>  app client secret (or PINGCODE_CLIENT_SECRET)
  --save                    also store the client id/secret in the config file (mode 0600)
  --mode <mode>             auth mode: user (authorization_code, default) or enterprise
                            (client_credentials)
  --channel <channel>       user authorize channel: browser (default) | paste
  --code <code>             authorization code (paste channel, or to skip the browser loopback)
  -h, --help                display help for command
"
`;

exports[`auth logout --help > pins the --all flag (design D14) 1`] = `
"Usage: pingcode auth logout [options]

clear the active token slot (both with --all) and the metadata cache

Options:
  --all       clear both the enterprise and user token slots (and authMode)
  -h, --help  display help for command
"
`;
