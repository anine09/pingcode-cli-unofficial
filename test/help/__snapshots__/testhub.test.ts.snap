// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`testhub --help > testhub 1`] = `
"Usage: pingcode testhub [options] [command]

测试管理 testhub: libraries 测试库, cases 用例, plans 测试计划, runs 执行用例 (scopes pcp:read:testhub:testcase /
:testplan / :configuration)

Options:
  -h, --help      display help for command

Commands:
  libraries       test libraries 测试库 — the parent of every other testhub id
  cases           test cases 用例 (scopes pcp:read:testhub:testcase / pcp:write:testhub:testcase)
  plans           test plans 测试计划 (scope pcp:read:testhub:testplan)
  runs            test runs 执行用例 (scopes pcp:read:testhub:testplan / pcp:write:testhub:testplan)
  meta            ids you need before writing: case states, types, importance levels, run results,
                  plan types, modules
  help [command]  display help for command
"
`;

exports[`testhub --help > testhub cases 1`] = `
"Usage: pingcode testhub cases [options] [command]

test cases 用例 (scopes pcp:read:testhub:testcase / pcp:write:testhub:testcase)

Options:
  -h, --help               display help for command

Commands:
  list [options]           search cases in a library (POST /v1/testhub/cases/search)
  get [options] <case>     show one case (accepts an id or a short_id)
  create [options]         create a case (only the library and --title are required)
  update [options] <case>  patch a case — only the fields you pass are sent, and they replace
  relation                 关联 cross-kind links of a test case (principal_type=test_case)
  comment                  评论 comments on a test case (principal_type=test_case)
  attachment               附件 attachments of a test case (principal_type=test_case)
  activity                 活动记录 audit trail of a test case (principal_type=test_case)
  help [command]           display help for command
"
`;

exports[`testhub --help > testhub libraries 1`] = `
"Usage: pingcode testhub libraries [options] [command]

test libraries 测试库 — the parent of every other testhub id

Options:
  -h, --help               display help for command

Commands:
  list [options]           list test libraries
  get [options] <library>  show one test library
  create [options]         create a test library (the identifier must be unique in the
                           organisation)
  help [command]           display help for command
"
`;

exports[`testhub --help > testhub meta 1`] = `
"Usage: pingcode testhub meta [options] [command]

ids you need before writing: case states, types, importance levels, run results, plan types,
modules

Options:
  -h, --help                  display help for command

Commands:
  case-states [options]       case states of a library (values for --state / state_id) — scope
                              pcp:read:testhub:configuration
  case-types [options]        case types of a library (values for --type / type_id) — needs only
                              pcp:read:testhub:testcase
  important-levels [options]  case importance levels (values for --important-level) —
                              organisation-wide, so this takes no library
  run-statuses [options]      run results 执行结果 of a library (values for --status / status_id) —
                              scope pcp:read:testhub:configuration
  plan-types [options]        plan types of a library (values for --type on \`plans create\`) — scope
                              pcp:read:testhub:testplan
  suites [options]            case modules 模块 of a library (values for --suite) — a tree, listed
                              flat with the full path; scope pcp:read:testhub:library
  help [command]              display help for command
"
`;

exports[`testhub --help > testhub plans 1`] = `
"Usage: pingcode testhub plans [options] [command]

test plans 测试计划 (scope pcp:read:testhub:testplan)

Options:
  -h, --help            display help for command

Commands:
  list [options]        list the plans of a library
  get [options] <plan>  show one plan (accepts an id or a short_id)
  create [options]      create a test plan (the name must be unique within the library)
  help [command]        display help for command
"
`;

exports[`testhub --help > testhub runs 1`] = `
"Usage: pingcode testhub runs [options] [command]

test runs 执行用例 (scopes pcp:read:testhub:testplan / pcp:write:testhub:testplan)

Options:
  -h, --help             display help for command

Commands:
  list [options]         search runs (POST /v1/testhub/runs/search) — run search cannot filter by
                         library.id — it is on the API exclusion list, so scope runs with --plan
                         instead
  patch [options] <run>  record a result on a run — always sends status_id, and re-sends the run's
                         own executor unless you name another one
  bulk [options]         insert, update and delete the runs of one plan in a single call — the only
                         way to delete a run. Each list is capped at 50, checked before the request
  relation               关联 cross-kind links of a test run (principal_type=test_run)
  comment                评论 comments on a test run (principal_type=test_run)
  attachment             附件 attachments of a test run (principal_type=test_run)
  activity               活动记录 audit trail of a test run (principal_type=test_run)
  help [command]         display help for command
"
`;
