// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`project --help > project 1`] = `
"Usage: pingcode project [options] [command]

项目管理 pjm: projects and work items (scope pcp:read:pjm:project)

Options:
  -h, --help               display help for command

Commands:
  list [options]           list projects
  get [options] <project>  show one project
  work-item                work items (scopes pcp:read:pjm:workitem / pcp:write:pjm:workitem)
  sprint                   迭代 sprints: plan and update them (scopes pcp:read:pjm:sprint /
                           pcp:write:pjm:sprint)
  version                  发布 releases of a project (scopes pcp:read:pjm:release /
                           pcp:write:pjm:release)
  meta                     ids you need before writing: every pjm lookup is scoped to one project
  help [command]           display help for command
"
`;

exports[`project --help > project meta 1`] = `
"Usage: pingcode project meta [options] [command]

ids you need before writing: every pjm lookup is scoped to one project

Options:
  -h, --help            display help for command

Commands:
  types [options]       work-item types of a project (values for --type / type_id)
  states [options]      work-item states of one (project, type) pair — both are required
  priorities [options]  work-item priorities of a project
  sprints [options]     sprints of a project (scrum/hybrid only)
  help [command]        display help for command
"
`;

exports[`project --help > project sprint (the two absences are in the group help) 1`] = `
"Usage: pingcode project sprint [options] [command]

迭代 sprints: plan and update them (scopes pcp:read:pjm:sprint / pcp:write:pjm:sprint)

Options:
  -h, --help                 display help for command

Commands:
  get [options] <sprint>     show one sprint
  create [options]           create a sprint (permanent — there is no way to delete one)
  update [options] <sprint>  patch a sprint — only the fields you pass are sent, and arrays replace
  bulk [options]             create many sprints in one atomic call — 企业令牌 only, and permanent
  help [command]             display help for command
"
`;

exports[`project --help > project sprint bulk (the entry schema and the ENT-only note) 1`] = `
"Usage: pingcode project sprint bulk [options]

create many sprints in one atomic call — 企业令牌 only, and permanent

Options:
  --file <path|->       JSON array of entries, or - for stdin (see below)
  --project <name|id>   default project for entries that name none
  --assignee <name|id>  default owner for entries that name none
  -h, --help            display help for command
"
`;

exports[`project --help > project sprint create (permanent, and the widest sprint flag set) 1`] = `
"Usage: pingcode project sprint create [options]

create a sprint (permanent — there is no way to delete one)

Options:
  --project <name|id>   project name or id — a sprint lives inside one project
  --name <text>         sprint name, unique within the project
  --start <date>        start — a date (2026-08-31) or a 10-digit unix seconds value, stored at
                        00:00:00 local
  --end <date>          end — a date (2026-08-31) or a 10-digit unix seconds value, stored at
                        23:59:59 local
  --assignee <name|id>  sprint owner 负责人 — the API requires one
  --description <text>  description
  --status <status>     initial status: pending | in_progress | completed (default pending)
  --category-id <id>    迭代类别 id, repeatable — replaces the whole set
  -h, --help            display help for command
"
`;

exports[`project --help > project version (the four-way name collision is in the group help) 1`] = `
"Usage: pingcode project version [options] [command]

发布 releases of a project (scopes pcp:read:pjm:release / pcp:write:pjm:release)

Options:
  -h, --help                  display help for command

Commands:
  list [options]              list the releases of a project
  get [options] <version>     show one release
  create [options]            create a release
  update [options] <version>  patch a release — only the fields you pass are sent, and arrays
                              replace
  delete [options] <version>  delete a release — the only delete in the pjm planning surface
  bulk [options]              create many releases in one atomic call — 企业令牌 only
  help [command]              display help for command
"
`;

exports[`project --help > project version delete (the only delete in the planning surface) 1`] = `
"Usage: pingcode project version delete [options] <version>

delete a release — the only delete in the pjm planning surface

Arguments:
  version              release 发布 name or id

Options:
  --project <name|id>  project name or id — checked on this verb only
  --yes                confirm: this cannot be undone
  -h, --help           display help for command
"
`;

exports[`project --help > project version update (--operate-at needs --stage-id) 1`] = `
"Usage: pingcode project version update [options] <version>

patch a release — only the fields you pass are sent, and arrays replace

Arguments:
  version               release 发布 name or id

Options:
  --project <name|id>   project name or id (the API does not check this one)
  --name <text>         new name
  --start <date>        new start — a date (2026-08-31) or a 10-digit unix seconds value, stored at
                        00:00:00 local
  --end <date>          new end — a date (2026-08-31) or a 10-digit unix seconds value, stored at
                        23:59:59 local
  --assignee <name|id>  new owner
  --stage-id <id>       move to this stage; needs --operate-at unless the release has been in it
                        before
  --operate-at <date>   when the release reached --stage-id — a date (2026-08-31) or a 10-digit
                        unix seconds value, read at 00:00:00 local like --start. Must fall inside
                        the release window, and is only valid WITH --stage-id: alone the API
                        accepts it, echoes the old value and stores nothing
  --category-id <id>    repeatable; replaces the whole set
  -h, --help            display help for command
"
`;

exports[`project --help > project work-item 1`] = `
"Usage: pingcode project work-item [options] [command]

work items (scopes pcp:read:pjm:workitem / pcp:write:pjm:workitem)

Options:
  -h, --help                        display help for command

Commands:
  list [options]                    list work items of a project
  get [options] <work-item>         show one work item
  create [options]                  create a work item (ids are project-scoped: run \`pingcode
                                    project meta\` first)
  update [options] <work-item>      patch a work item — only the fields you pass are sent, and they
                                    replace
  transition [options] <work-item>  move a work item to another state (workflow-validated by the
                                    server)
  relation                          关联 cross-kind links of a work item (principal_type=work_item)
  comment                           评论 comments on a work item (principal_type=work_item)
  attachment                        附件 attachments of a work item (principal_type=work_item)
  activity                          活动记录 audit trail of a work item (principal_type=work_item)
  help [command]                    display help for command
"
`;

exports[`project --help > project work-item transition (--type is a lookup aid, not a patched field) 1`] = `
"Usage: pingcode project work-item transition [options] <work-item>

move a work item to another state (workflow-validated by the server)

Arguments:
  work-item         id, short_id, identifier such as SCR-5, or a pasted URL

Options:
  --type <name|id>  work-item type — used only to resolve --state <name> and to list candidate
                    states on rejection; never sent
  --state <name>    target state, resolved by name (requires --type)
  --state-id <id>   target state, given as an id (no lookup, no --type needed)
  -h, --help        display help for command
"
`;

exports[`project --help > project work-item update (the widest flag set) 1`] = `
"Usage: pingcode project work-item update [options] <work-item>

patch a work item — only the fields you pass are sent, and they replace

Arguments:
  work-item                 id, short_id, identifier such as SCR-5, or a pasted URL

Options:
  --title <text>            new title
  --description <text>      new description (replaces the old one)
  --type <name|id>          work-item type — used only to resolve --state <name> and to list
                            candidate states on rejection; never sent
  --assignee <name|id>      new assignee
  --priority <name|id>      new priority
  --parent <ref>            new parent work item
  --start-at <when>         unix seconds or a date like 2026-01-31
  --end-at <when>           unix seconds or a date like 2026-01-31
  --story-points <n>        story points
  --estimated-workload <n>  estimated workload in hours
  --remaining-workload <n>  remaining workload in hours
  --state <name>            new state, resolved by name (requires --type)
  --state-id <id>           new state, given as an id (no lookup, no --type needed)
  -h, --help                display help for command
"
`;
